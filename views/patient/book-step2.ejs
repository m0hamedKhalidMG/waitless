<div class="booking-steps">
  <div class="step done">1. التخصص</div>
  <div class="step active">2. الطبيب</div>
  <div class="step">3. الموعد</div>
</div>

<div class="breadcrumb">
  <a href="/patient/book">← تغيير التخصص</a>
  <span> / <%= specialty.name %></span>
</div>

<div class="welcome-banner">
  <h2>اختر الطبيب المناسب</h2>
  <p>تخصص: <%= specialty.name %></p>
</div>

<% if (doctors.length === 0) { %>
  <div class="empty-state">
    <div class="empty-icon">👨‍⚕️</div>
    <p>لا يوجد أطباء متاحون في هذا التخصص حالياً</p>
    <a href="/patient/book" class="btn btn-outline">العودة</a>
  </div>
<% } else { %>
  <div class="doctors-grid">
    <% doctors.forEach(doc => { %>
      <a href="/patient/book/slots?doctor_id=<%= doc.id %>" class="doctor-card">
        <div class="doctor-avatar"><%= doc.name.charAt(0) %></div>
        <div class="doctor-info">
          <div class="doctor-name"><%= doc.name %></div>
          <div class="doctor-meta">⏱ متوسط الكشف: <%= doc.avg_consultation_minutes %> دقيقة</div>
          <% if (doc.phone) { %><div class="doctor-meta">📞 <%= doc.phone %></div><% } %>
        </div>
        <div class="doctor-action">اختيار ←</div>
      </a>
    <% }) %>
  </div>
<% } %>