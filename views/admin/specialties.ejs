<!-- Add specialty -->
<div class="section">
  <div class="section-header">
    <h2><span class="title-icon">➕</span> إضافة تخصص</h2>
  </div>
  <form method="POST" action="/admin/specialties" class="form-card">
    <div class="form-inline">
      <div class="form-group" style="flex:1">
        <label>اسم التخصص</label>
        <input type="text" name="name" placeholder="مثال: طب الأسنان" required>
      </div>
      <button class="btn btn-primary" style="align-self:flex-end">➕ إضافة</button>
    </div>
  </form>
</div>

<!-- Specialties list -->
<div class="section">
  <div class="section-header">
    <h2><span class="title-icon">🏷</span> التخصصات الطبية</h2>
  </div>
  <% if (specialties.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">🏷</div>
      <p>لا توجد تخصصات</p>
    </div>
  <% } else { %>
    <div class="table-wrap">
      <table class="data-table">
        <thead>
          <tr><th>#</th><th>التخصص</th><th>عدد الأطباء</th><th>إجراءات</th></tr>
        </thead>
        <tbody>
          <% specialties.forEach((s, i) => { %>
            <tr>
              <td><%= i+1 %></td>
              <td><strong><%= s.name %></strong></td>
              <td><span class="status-badge status-confirmed"><%= s.doctor_count %> طبيب</span></td>
              <td>
                <% if (s.doctor_count === 0) { %>
                  <form method="POST" action="/admin/specialties/<%= s.id %>/delete" onsubmit="return confirm('حذف التخصص؟')">
                    <button class="btn btn-danger btn-xs">🗑 حذف</button>
                  </form>
                <% } else { %>
                  <span class="hint" style="margin:0">غير قابل للحذف</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>